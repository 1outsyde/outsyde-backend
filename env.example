# App
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth (all three are required — the server will refuse to start without them)
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# URLs (required in production)
API_BASE_URL=
FRONTEND_URL=
WEBHOOK_BASE_URL=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@outsyde.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@outsyde.com

# Expo Dev (development only)
EXPO_DEV_URL=http://localhost:8081
